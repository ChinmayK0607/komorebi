# This is a conservative tracking boundary for a future repository.
# Keep active painter source/config/docs/tests/run scripts and reviewed small
# manifests. The parent agent owns Git initialization, reviewed commits, and
# pushes to the user-designated remote.

# Unrelated clones, scratch work, and generated top-level outputs.
/work/
/outputs/

# Python/JS/build caches and local environments.
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
*/.venv/
*/venv/
*/env/
prime-adapter-venv/
renderer-env/
runtime/
node_modules/
.pnpm-store/
*.egg-info/

# Credentials, host material, and local configuration.
.env
.env.*
*.pem
*.key
*token*
*secret*
*credential*
painter/known_hosts

# Archives, model weights, and other large binary state.
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx

# Rendered images and judge image batches. Small manifests remain eligible.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff
*.ico

# Raw/streaming experiment data. Curated Markdown/JSON records are unignored
# below only when their names are explicit and their size is reviewed.
*.log
*.log.*
*.jsonl
*.jsonl.gz
*.ndjson
*.ndjson.gz
painter/collected/
painter/data/
# Collected teacher API responses, canvases, and pilot galleries stay local.
painter/benchmarks/openrouter-teachers-20260922/results-ai-gateway-*/
painter/benchmarks/openrouter-teachers-20260922/gallery.html
# Run directories are generated by default. Permit reviewed first-level source,
# tests, run scripts, Markdown records, and named manifests/configs only; do
# not recursively unignore copied source or generated experiment subtrees.
painter/runs/**
!painter/runs/
!painter/runs/*/
!painter/runs/*/*.py
!painter/runs/*/*.cjs
!painter/runs/*/*.js
!painter/runs/*/*.sh
!painter/runs/*/*.md
!painter/runs/*/EXPERIMENT.json
!painter/runs/*/manifest*.json
!painter/runs/*/*manifest*.json
!painter/runs/*/config*.json
!painter/runs/*/receipt*.json
# The bounded COCO capability run keeps its two reviewed native-eval TOML
# configs alongside the manifest so a Linux node can stage them verbatim.
!painter/runs/coco-capability-20260922/base.toml
!painter/runs/coco-capability-20260922/sft.toml
# The scaled real-reference importer keeps a small reviewable manifest/doc
# inside an ignored raw/image subtree; leave the source bytes out of Git.
!painter/runs/*/real-pool/
!painter/runs/*/real-pool/*.md
!painter/runs/*/real-pool/*manifest*.json

# Keep provider snapshots, connection details, queues, images and copied
# inputs out of the tracked surface even if they sit at a run root.
painter/runs/**/state.json
painter/runs/**/latest-status.json
painter/runs/**/pod*.json
painter/runs/**/release*.json
painter/runs/**/unreachable*.json
painter/runs/**/private-key.json
painter/runs/**/judge-*.json
painter/runs/**/labels-*.json
painter/runs/**/review-input.json
painter/runs/**/pairs.json
painter/runs/**/data/
painter/runs/**/previews/
painter/runs/**/collected-*/
painter/runs/**/diagnostic/
painter/runs/**/rl-rollouts/
painter/runs/**/rollouts/
painter/runs/**/judge-queue/
painter/runs/**/reward-batches/
painter/runs/**/luna-live-*/
painter/runs/**/vendor/
painter/runs/**/source/
painter/runs/**/inputs/

# Additional generated datasets and gallery trees under painter.
painter/data-*/
painter/*gallery*/
painter/galleries/
painter/figures/

# Provider/checkpoint receipts in the painter root are generated state.
painter/pod*.json
painter/release*.json
painter/unreachable*.json
painter/run-summary.json
painter/visual-review.json
painter/selected-checkpoint.json

# Full source annotations remain reproducible from the pinned import.
painter/runs/*/real-pool/reference-manifest.json
